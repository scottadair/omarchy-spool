pkgname=spool
pkgver=0.1.0
pkgrel=1
pkgdesc='Printer settings for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'libcups' 'cups' 'cups-pk-helper' 'cups-filters')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/spool "$pkgdir/usr/bin/spool"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/spool.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/spool.svg"
  install -Dm644 "$startdir/spool.desktop" "$pkgdir/usr/share/applications/spool.desktop"
}
